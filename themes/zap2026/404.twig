{% extends 'layout/default.twig' %}

{% block content %}
{% do pageState.offsetSet('is404', true) %}
{% set catalogMenu = pageState.getCatalogList() %}
<style>
    .error-404-page { text-align: center; padding: 60px 0; }
    .error-404-icon { font-size: 64px; color: #1e6bff; margin-bottom: 10px; }
    .error-404-code { font-size: 80px; font-weight: 800; color: #1e6bff; margin: 0; }
    .error-404-title { font-size: 24px; margin: 10px 0; }
    .error-404-desc { color: #888; margin-bottom: 24px; }
    .error-404-search { max-width: 420px; margin: 0 auto 24px; }
    .error-404-actions .btn { margin: 0 6px; }
    .error-404-links { margin-top: 30px; }
    .error-404-links a { display: inline-block; margin: 6px; padding: 6px 14px; border: 1px solid #e2e8f0; border-radius: 20px; color: #1e6bff; text-decoration: none; }
    .error-404-links a:hover { background: #1e6bff; color: #fff; }
</style>
<main class="site-main">
    <div class="container">
        <div class="error-404-page">
            <div class="error-404-icon"><i class="fa fa-frown-o"></i></div>
            <h1 class="error-404-code">404</h1>
            <h2 class="error-404-title">页面走丢了</h2>
            <p class="error-404-desc">您访问的页面不存在、已被移除或网址有误，请检查后重试。</p>
            <form class="error-404-search" action="{{ append_url_suffix(site_url('/search')) }}" method="get">
                <div class="input-group">
                    <input autocomplete="off" type="text" name="q" class="form-control" placeholder="搜索您想找的内容…">
                    <button class="btn btn-outline-secondary" type="submit"><i class="fa fa-search"></i></button>
                </div>
            </form>
            <div class="error-404-actions">
                <a href="{{ home_url() }}" class="btn btn-back"><i class="fa fa-home"></i> 返回首页</a>
                <button type="button" class="btn btn-outline-secondary" onclick="history.back()"><i class="fa fa-arrow-left"></i> 返回上一页</button>
            </div>
            {% if catalogMenu is not empty %}
            <div class="error-404-links">
                <h4>您可能还想访问：</h4>
                <div>
                    {% for menu in catalogMenu %}
                    <a href="{{ node_url(menu) }}">{{ menu.title }}</a>
                    {% endfor %}
                </div>
            </div>
            {% endif %}
        </div>
    </div>
</main>
{% endblock %}
