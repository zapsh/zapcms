{% set state = pageState %}
{# 导航 / 页脚数据源：后台「外观 > 菜单」构建并分配到对应位置的菜单（未分配时回退栏目树） #}
{% set catalogMenu = state.getNavMenu('top') %}
{% set footerCatalogMenu = state.getNavMenu('footer') %}

{# ── SEO 兜底：控制器未设置 pageTitle 时统一补全 ── #}
{% set siteTitle = (option('website.title', 'ZAP CMS') ?? '')|trim %}
{% if siteTitle == '' %}{% set siteTitle = 'ZAP CMS' %}{% endif %}
{% set siteSlogan = (option('website.slogan', '') ?? '')|trim %}
{% set node = state.node ?? {} %}
{% set nodeTitle = (node.title ?? '')|trim %}

{% if (state.pageTitle ?? '')|trim == '' %}
  {% if state.is404 %}
    {% set pageTitle = '页面未找到 - ' ~ siteTitle %}
  {% elseif state.isSearch %}
    {% set pageTitle = '搜索结果 - ' ~ siteTitle %}
  {% elseif nodeTitle != '' and nodeTitle != siteTitle %}
    {% set pageTitle = nodeTitle ~ ' - ' ~ siteTitle %}
  {% elseif siteSlogan != '' %}
    {% set pageTitle = siteTitle ~ ' - ' ~ siteSlogan %}
  {% else %}
    {% set pageTitle = siteTitle %}
  {% endif %}
  {% do state.offsetSet('pageTitle', pageTitle) %}
{% endif %}

{% if (state.pageKeywords ?? '')|trim == '' %}
  {% set pageKeywords = (node.keywords ?? '')|trim ?: (option('website.keywords', '') ?? '') %}
  {% do state.offsetSet('pageKeywords', pageKeywords) %}
{% endif %}

{% if (state.pageDescription ?? '')|trim == '' %}
  {% set pageDescription = (node.description ?? '')|trim %}
  {% if pageDescription == '' %}{% set pageDescription = (node.excerpt ?? '')|striptags|trim %}{% endif %}
  {% if pageDescription == '' %}{% set pageDescription = (option('website.description', '') ?? '')|trim %}{% endif %}
  {% do state.offsetSet('pageDescription', pageDescription) %}
{% endif %}

<!DOCTYPE html>
<html lang="{{ html_lang() }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {{ state.printMeta()|raw }}
    <link href="{{ theme_url('css/bootstrap.min.css') }}" rel="stylesheet">
    <link href="{{ theme_url('css/font-awesome.min.css') }}" rel="stylesheet">
    <link href="{{ theme_url('css/style.css') }}" rel="stylesheet">
    {% if state.isHome %}
    <link href="{{ theme_url('css/swiper-bundle.min.css') }}" rel="stylesheet">
    <script src="{{ theme_url('js/swiper-bundle.min.js') }}"></script>
    {% endif %}
    <link href="{{ theme_url('css/page-styles.css') }}" rel="stylesheet">
    <link href="{{ theme_url('css/zap2026.css') }}" rel="stylesheet">

    {{ option('website.head_script')|raw }}
    {{ print_styles() }}
</head>
<body>

{{ include('partials/_navbar.twig', { catalogMenu: catalogMenu }) }}

{% block content %}{% endblock %}

{{ include('partials/_footer.twig', { footerCatalogMenu: footerCatalogMenu }) }}

<script src="{{ theme_url('js/bootstrap.bundle.min.js') }}"></script>

{{ print_scripts(constant('ASSETS_BODY')) }}
{{ print_scripts(constant('ASSETS_BODY_TEXT')) }}

{{ option('website.foot_script')|raw }}
<script>
(function () {
    var header = document.getElementById('zHeader');

    // 吸顶阴影
    if (header) {
        window.addEventListener('scroll', function () {
            header.classList.toggle('is-scrolled', window.scrollY > 10);
        });
    }

    // 移动端二级菜单：点击展开 / 收起（桌面端由 CSS hover 负责）
    document.querySelectorAll('.z-menu .z-link--toggle').forEach(function (toggler) {
        toggler.addEventListener('click', function (e) {
            if (window.innerWidth < 992) {
                e.preventDefault();
                e.stopPropagation();
                var item = toggler.closest('.has-dropdown');
                if (!item) return;
                var willOpen = !item.classList.contains('open');
                document.querySelectorAll('.z-menu .has-dropdown.open').forEach(function (o) {
                    o.classList.remove('open');
                });
                item.classList.toggle('open', willOpen);
            }
        });
    });

    // 回到桌面端时清理遗留展开态
    window.addEventListener('resize', function () {
        if (window.innerWidth >= 992) {
            document.querySelectorAll('.z-menu .has-dropdown.open').forEach(function (item) {
                item.classList.remove('open');
            });
        }
    });

    // 返回顶部
    var btn = document.querySelector('.back-to-top');
    if (btn) {
        window.addEventListener('scroll', function () {
            btn.classList.toggle('show', window.scrollY > 300);
        });
        btn.addEventListener('click', function () {
            window.scrollTo({ top: 0, behavior: 'smooth' });
        });
    }
})();
</script>

<div class="back-to-top">
    <i class="fa fa-chevron-up"></i>
</div>

</body>
</html>
